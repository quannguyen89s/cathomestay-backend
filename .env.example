NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/BookingRoom?retryWrites=true&w=majority
JWT_SECRET=your_super_strong_random_jwt_secret_at_least_32_characters
JWT_EXPIRE=7d

# Comma-separated list of allowed CORS origins (frontend URLs)
ALLOWED_ORIGINS=https://cathomestay.studio,https://www.cathomestay.studio,http://localhost:5173

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google OAuth Login
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Email SMTP (for password reset OTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=HomeStay Support <no-reply@homestay.vn>
